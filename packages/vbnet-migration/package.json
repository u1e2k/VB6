{
  "name": "@vb6-studio/vbnet-migration",
  "version": "0.1.0",
  "description": "Extensible VB6-to-VB.NET .NET 10 source migration, WinForms export and deterministic project archives",
  "type": "module",
  "main": "./lib/src/migration/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/src/migration/index.js"
    },
    "./cli": {
      "types": "./cli.d.ts",
      "import": "./lib/src/migration/cli.mjs"
    },
    "./browser": "./dist/vbnet-migration.js"
  },
  "bin": {
    "vb6-migrate": "./bin/vb6-migrate.mjs"
  },
  "files": [
    "lib",
    "dist",
    "bin",
    "index.d.ts",
    "cli.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wieslawsoltes/VB6.git",
    "directory": "packages/vbnet-migration"
  }
}
